# Cloudflare Pages headers. Security baseline; connect-src stays broad because
# wallet extensions, Walrus relays, and per-network Sui RPCs vary.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Long-cache hashed build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
