{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/config.ts",
    "src/lib/types.ts",
    "src/lib/validation.ts",
    "src/lib/form.ts",
    "src/lib/template.ts",
    "src/lib/buildPublishTx.ts",
    "src/lib/deploy.ts",
    "src/lib/generatePackage.ts",
    "src/lib/licenses.ts",
    "src/lib/github.ts",
    "src/lib/walrus.ts",
    "src/lib/walrus-constants.ts",
    "src/composables/useWallet.ts",
    "src/composables/useSuiClient.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "includeVersion": true,
  "skipErrorChecking": true,
  "categorizeByGroup": true,
  "validation": {
    "invalidLink": false,
    "notExported": false
  },
  "navigationLinks": {
    "Repository": "https://github.com/meddleware"
  }
}
